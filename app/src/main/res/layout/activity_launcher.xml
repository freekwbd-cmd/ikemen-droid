<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Cinematic background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/piash_bg"
        android:scaleType="centerCrop" />

    <!-- Iori character, left/center -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="8dp"
        android:src="@drawable/piash_iori"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- Dark gradient overlay for readability on right side -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/piash_scrim" />

    <!-- Logo top-left -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="280dp"
        android:layout_height="140dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="12dp"
        android:layout_marginLeft="16dp"
        android:src="@drawable/piash_logo"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <!-- IORI YAGAMI label top-right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="16dp"
        android:layout_marginRight="20dp"
        android:orientation="vertical"
        android:gravity="right">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IORI YAGAMI"
            android:textColor="#FF2222"
            android:textSize="28sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="八神 庵"
            android:textColor="#AA2222"
            android:textSize="16sp"
            android:fontFamily="@font/yagami" />
    </LinearLayout>

    <!-- Action buttons, right side (menu position like reference) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="48dp"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btn_start_game"
            android:layout_width="260dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:text="START GAME"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <Button
            android:id="@+id/btn_select_folder"
            android:layout_width="260dp"
            android:layout_height="64dp"
            android:text="SELECT GAME FOLDER"
            android:textColor="#FFAAAA"
            android:textSize="18sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/tv_folder_path"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No game folder selected"
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_install_theme"
            android:layout_width="260dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="INSTALL PIASH THEME"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button" />

        <TextView
            android:id="@+id/tv_theme_status"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- THE KING OF FIGHTERS label bottom-left -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentBottom="true"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="48dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THE KING OF FIGHTERS"
            android:textColor="#FF3333"
            android:textSize="22sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IORI YAGAMI"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:fontFamily="@font/yagami"
            android:textStyle="italic"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

    <!-- Footer bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_alignParentBottom="true"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PIASH MUGEN GO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/yagami" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="BLOOD AWAKENS THE REAL POWER"
            android:textColor="#FF5555"
            android:textSize="12sp"
            android:fontFamily="@font/yagami"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MUGEN ENGINE"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:fontFamily="@font/yagami"
            android:gravity="right" />
    </LinearLayout>

</RelativeLayout>
