<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Cinematic background: new PIASH MUGEN key art (Ken Burns animated in code) -->
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/piash_bg"
        android:scaleType="centerCrop" />

    <!-- Vignette: darken edges for cinematic depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/piash_vignette" />

    <!-- Floating ember particles -->
    <org.libsdl.app.EmberView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pulsing red glow at bottom (breathing animation in code) -->
    <View
        android:id="@+id/v_glow"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/piash_bottom_glow" />

    <!-- Control bar: functional buttons, styled to match the key art -->
    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btn_select_folder"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginRight="8dp"
            android:text="📁 FOLDER"
            android:textColor="#FFAAAA"
            android:textSize="15sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button" />

        <Button
            android:id="@+id/btn_start_game"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.3"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="▶ START GAME"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button"
            android:shadowColor="#FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <Button
            android:id="@+id/btn_install_theme"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="🎨 THEME"
            android:textColor="#FFD700"
            android:textSize="15sp"
            android:fontFamily="@font/yagami"
            android:textStyle="bold|italic"
            android:background="@drawable/piash_menu_button" />
    </LinearLayout>

    <!-- Folder path + theme status, above the control bar -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layout_controls"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_folder_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No game folder selected"
            android:textColor="#AA888888"
            android:textSize="11sp"
            android:fontFamily="@font/yagami"
            android:maxLines="1"
            android:ellipsize="middle"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <TextView
            android:id="@+id/tv_theme_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:fontFamily="@font/yagami"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />
    </LinearLayout>

</RelativeLayout>
