<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#88220000" />
            <stroke android:width="2dp" android:color="#FFFF3333" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#44111111" />
            <stroke android:width="2dp" android:color="#44FF3333" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#66111111" />
            <stroke android:width="2dp" android:color="#AAFF2222" />
        </shape>
    </item>
</selector>
